{
  // Type-checks the pure core with JSDoc types. Widen "include" as more files get typed.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "skipLibCheck": true
  },
  "include": ["src/core/*.js", "src/popup/report.js", "src/adapters/press.js", "src/types.js"]
}
