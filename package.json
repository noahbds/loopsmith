{
  "name": "loopsmith",
  "version": "1.2.0",
  "private": true,
  "description": "A-B loop for any song or video: repeat one or several sections, a chosen number of times or forever.",
  "keywords": [
    "browser-extension",
    "chrome-extension",
    "firefox-addon",
    "a-b-repeat",
    "loop",
    "music-practice"
  ],
  "homepage": "https://github.com/noahbds/loopsmith#readme",
  "bugs": {
    "url": "https://github.com/noahbds/loopsmith/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noahbds/loopsmith.git"
  },
  "author": "noahbds",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "check": "node --check dist/firefox/content.js && node --check dist/chrome/content.js",
    "e2e": "node test/e2e/run.mjs",
    "e2e:live": "node test/e2e/live.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "playwright": "^1.65.0",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
